{
  "name": "dsh-reload-restart",
  "version": "1.9.0",
  "type": "module",
  "description": "Adds reload and restart buttons to the DeepSeek Harness desktop top menu bar.",
  "license": "MIT",
  "author": "wind-h",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wind-h/dsh-reload-restart.git"
  },
  "homepage": "https://github.com/wind-h/dsh-reload-restart#readme",
  "bugs": "https://github.com/wind-h/dsh-reload-restart/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reload",
    "restart"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/restart-app.mjs",
    "cordis.patch.yml",
    "locale/zh-CN.json",
    "locale/en.json",
    "docs/DETAIL.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
